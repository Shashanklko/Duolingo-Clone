{
  "_schema_notes": {
    "purpose": "One data model reused across all 10 languages. Free typing is only used when the expected answer is in the learner's NATIVE language (guaranteed keyboard). Any answer that must be produced IN the target language uses tile construction instead of free text.",
    "levelTypes": {
      "1": "mcq - multiple choice, no typing",
      "2": "tile_build - construct word/sentence from shuffled tiles (replaces free 'write')",
      "3": "puzzle - reorder/match tiles",
      "4": "listen_select - play audio, reconstruct answer via tiles (replaces free 'listen and write')",
      "5": "translate - free_text only if direction is target_to_native; tile_build if native_to_target"
    }
  },

